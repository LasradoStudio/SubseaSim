  {"label": "orbit", "commands": [{"cmd": "camera", "shot": "orbit", "orbit_dps": 0}], "wait": 1.5},
  {"label": "orbit shot", "commands": [{"cmd": "screenshot", "name": "p_orbit"}], "wait": 1.5},
  {"label": "wide", "commands": [{"cmd": "camera", "shot": "wide", "orbit_dps": 0}], "wait": 1.5},
  {"label": "wide shot", "commands": [{"cmd": "screenshot", "name": "p_wide"}], "wait": 1.5},
  {"label": "flyby", "commands": [{"cmd": "camera", "shot": "flyby"}], "wait": 9},
  {"label": "flyby shot", "commands": [{"cmd": "screenshot", "name": "p_flyby"}], "wait": 1.5},
